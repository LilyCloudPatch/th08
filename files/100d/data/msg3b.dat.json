{
  "schema": "lilypatch.text.v1",
  "target_id": "th08_100d",
  "resource": "data/msg3b.dat",
  "entries": {
    "0/60_0": {
      "original_lines": [
        "流石にこれ以上は下がれないな。"
      ],
      "translated_lines": [
        "真的不能再后退了。"
      ]
    },
    "0/60_1": {
      "original_lines": [
        "さぁ、人間を明け渡して貰おうか。"
      ],
      "translated_lines": [
        "来，把人类交出来吧。"
      ]
    },
    "0/61_0": {
      "original_lines": [
        "ちょっとちょっと魔理沙！"
      ],
      "translated_lines": [
        "等等等等，魔理沙！"
      ]
    },
    "0/62_0": {
      "original_lines": [
        "誰が、人間をとって喰おうって言ったのよ。"
      ],
      "translated_lines": [
        "谁说，要捉人类来吃了啊。"
      ]
    },
    "0/63_0": {
      "original_lines": [
        "ふん。",
        "こんな里まで妖怪が来るようになるなんて。"
      ],
      "translated_lines": [
        "哼。",
        "妖怪竟然都会跑到这种村子里来了。"
      ]
    },
    "0/64_0": {
      "original_lines": [
        "やはり異常な月の所為か。",
        "今まで、滅多に来る事は無かったんだがな。"
      ],
      "translated_lines": [
        "果然是因为异常的月亮吗。",
        "至今还几乎没什么妖怪来过啊。"
      ]
    },
    "0/65_0": {
      "original_lines": [
        "誰も人間をとって喰うなんて言ってないぜ。"
      ],
      "translated_lines": [
        "谁也没说要抓人类来吃哟。"
      ]
    },
    "0/66_0": {
      "original_lines": [
        "とにかく。",
        "私は急いでるの！"
      ],
      "translated_lines": [
        "反正啊。",
        "我正着急着呢！"
      ]
    },
    "0/67_0": {
      "original_lines": [
        "あんたが誰だか知らないけど、人間なんか",
        "にかまっている暇は無いのよ。"
      ],
      "translated_lines": [
        "虽然不清楚你是谁，不过我可没时间",
        "和人类打交道了。"
      ]
    },
    "0/68_0": {
      "original_lines": [
        "酷いぜ。"
      ],
      "translated_lines": [
        "你说得好过分耶。"
      ]
    },
    "0/69_0": {
      "original_lines": [
        "大人しく通り過ぎてくれるなら、",
        "私も何もしまい。"
      ],
      "translated_lines": [
        "你们要是老老实实地路过，",
        "我也不会管什么。"
      ]
    },
    "0/70_0": {
      "original_lines": [
        "だが、お前達は少々騒々し過ぎる。"
      ],
      "translated_lines": [
        "不过，你们有点太吵闹了。"
      ]
    },
    "0/71_0": {
      "original_lines": [
        "ほら騒々しいって、魔理沙。"
      ],
      "translated_lines": [
        "瞧，她说吵闹，魔理沙。"
      ]
    },
    "0/72_0": {
      "original_lines": [
        "真夜中だというのに、",
        "あんたが思いっきり魔法を使うからよ。"
      ],
      "translated_lines": [
        "就因为你大半夜的，",
        "尽情使用魔法。"
      ]
    },
    "0/73_0": {
      "original_lines": [
        "何言ってるんだ？",
        "魔法は真夜中に思いっきり使うもんだぜ？"
      ],
      "translated_lines": [
        "你说什么呀？",
        "魔法就是要在半夜尽情地用呀？"
      ]
    },
    "0/74_0": {
      "original_lines": [
        "太陽の下で人知れずこっそりと使うのは、",
        "日光写真ぐらいなもんだ。"
      ],
      "translated_lines": [
        "会在大太阳底下偷偷摸摸地用的，",
        "也就是蓝晒法这种东西吧。"
      ]
    },
    "0/75_0": {
      "original_lines": [
        "なにやら不穏な空気が漂っていたので",
        "里を遮断したが……"
      ],
      "translated_lines": [
        "我就觉得有股邪气飘过来",
        "才把村落遮蔽的……"
      ]
    },
    "0/76_0": {
      "original_lines": [
        "どうやら正解のようだな。"
      ],
      "translated_lines": [
        "看来是做对了啊。"
      ]
    },
    "0/77_0": {
      "original_lines": [
        "だからー。"
      ],
      "translated_lines": [
        "我说过啦—。"
      ]
    },
    "0/78_0": {
      "original_lines": [
        "誰も人間を襲うなんていってない。"
      ],
      "translated_lines": [
        "谁也没说要袭击人类的。"
      ]
    },
    "0/79_0": {
      "original_lines": [
        "（……明け渡せとか言ってなかったっけ？）"
      ],
      "translated_lines": [
        "（……你刚刚不是说过把人类交出来吗？）"
      ]
    },
    "0/80_0": {
      "original_lines": [
        "むしろ目の前の人間に用事があるのだ！"
      ],
      "translated_lines": [
        "倒不如说我找我眼前的人类有事！"
      ]
    },
    "0/81_0": {
      "original_lines": [
        "何でもいいよ、この与太郎が。"
      ],
      "translated_lines": [
        "怎么都好了，你这笨蛋。"
      ]
    },
    "0/82_0": {
      "original_lines": [
        "里の人間にも里の歴史にも弾幕一本",
        "触れさせる物か！"
      ],
      "translated_lines": [
        "我不会让你们的弹幕碰到一丝",
        "村落的人类和村落的历史！"
      ]
    },
    "0/83_0": {
      "original_lines": [
        "魔理沙！"
      ],
      "translated_lines": [
        "魔理沙！"
      ]
    },
    "0/84_0": {
      "original_lines": [
        "分かっていないと思うけど、",
        "こいつは人間じゃないわ。"
      ],
      "translated_lines": [
        "我想也许你还不知道，",
        "这家伙不是人类。"
      ]
    },
    "0/85_0": {
      "original_lines": [
        "半獣よ。"
      ],
      "translated_lines": [
        "是半兽。"
      ]
    },
    "1/60_0": {
      "original_lines": [
        "満月が無くて変身出来ない半獣なんて、",
        "ただの人間だな。"
      ],
      "translated_lines": [
        "没有满月不能变身的半兽，",
        "也就是个人类而已啊。"
      ]
    },
    "1/61_0": {
      "original_lines": [
        "あんたもただの人間でしょ？"
      ],
      "translated_lines": [
        "你也就是个人类吧？"
      ]
    },
    "1/62_0": {
      "original_lines": [
        "満月さえあればこんな奴には……。"
      ],
      "translated_lines": [
        "只要是满月，怎么会败给你们……。"
      ]
    },
    "1/63_0": {
      "original_lines": [
        "そうそう。",
        "私たちは満月を取り戻そうとしているのよ。"
      ],
      "translated_lines": [
        "对了对了。",
        "我们正是要把满月复原的哟。"
      ]
    },
    "1/64_0": {
      "original_lines": [
        "そうだ。",
        "最初から言ってただろ？"
      ],
      "translated_lines": [
        "是的。",
        "一开始不就说了吗？"
      ]
    },
    "1/65_0": {
      "original_lines": [
        "あー？",
        "何だよそれ。聞いてない。"
      ],
      "translated_lines": [
        "啊—？",
        "什么嘛。根本没听说。"
      ]
    },
    "1/66_0": {
      "original_lines": [
        "あんたなら誰の仕業か知っていそうね。"
      ],
      "translated_lines": [
        "你的话，似乎知道这是谁干的吧。"
      ]
    },
    "1/67_0": {
      "original_lines": [
        "さぁ、私が勝ったんだから、約束通り",
        "教えて貰おうか。"
      ],
      "translated_lines": [
        "来，我赢了，",
        "按照约定告诉我们吧。"
      ]
    },
    "1/68_0": {
      "original_lines": [
        "約束は今作ったが。"
      ],
      "translated_lines": [
        "虽然是现做的约定。"
      ]
    },
    "2/61_0": {
      "original_lines": [
        "お前達か。",
        "こんな真夜中に里を襲おうとする奴は。"
      ],
      "translated_lines": [
        "就是你们吗。",
        "在这样的深夜里企图袭击村落的家伙。"
      ]
    },
    "2/62_0": {
      "original_lines": [
        "うにゃ。",
        "通りがかっただけだ。気にするな。"
      ],
      "translated_lines": [
        "喵呜。",
        "我们只是路过。别在意。"
      ]
    },
    "2/63_0": {
      "original_lines": [
        "ふん、妖怪の言う事なんか信用できないな。"
      ],
      "translated_lines": [
        "哼，妖怪说的话就是信不过啊。"
      ]
    },
    "2/64_0": {
      "original_lines": [
        "今夜を無かった事にしてやる！"
      ],
      "translated_lines": [
        "就让今夜当作没发生过吧！"
      ]
    },
    "3/61_0": {
      "original_lines": [
        "お前達何もんだ？"
      ],
      "translated_lines": [
        "你们是什么人？"
      ]
    },
    "3/62_0": {
      "original_lines": [
        "おっとそこは、",
        "やんごとなき事情を思い出した、だろ？"
      ],
      "translated_lines": [
        "哦，听你那话的意思，",
        "是想起了件不得不要做的事情，对吧？"
      ]
    }
  }
}
