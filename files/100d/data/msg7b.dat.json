{
  "schema": "lilypatch.text.v1",
  "target_id": "th08_100d",
  "resource": "data/msg7b.dat",
  "entries": {
    "0/60_0": {
      "original_lines": [
        "満月だな。"
      ],
      "translated_lines": [
        "满月呀。"
      ]
    },
    "0/121_0": {
      "original_lines": [
        "そう、ただの満月よ。"
      ],
      "translated_lines": [
        "不错，平常的满月哟。"
      ]
    },
    "0/122_0": {
      "original_lines": [
        "貴方達が何百年も何千年も見てきた",
        "本物の魔力。"
      ],
      "translated_lines": [
        "你们千百年来一直在看的东西",
        "真正的魔力。"
      ]
    },
    "0/123_0": {
      "original_lines": [
        "魔理沙、あの満月は危ないわ。"
      ],
      "translated_lines": [
        "魔理沙，那个满月很危险。"
      ]
    },
    "0/124_0": {
      "original_lines": [
        "満月が危ない？",
        "なに寝ぼけた事言ってるんだ？"
      ],
      "translated_lines": [
        "满月很危险？",
        "你说什么梦话呢？"
      ]
    },
    "0/125_0": {
      "original_lines": [
        "あなたには見えないかも知れないけど……"
      ],
      "translated_lines": [
        "也许你看不出来……"
      ]
    },
    "0/126_0": {
      "original_lines": [
        "いま、大量に満月光線が降り注いでいるわ。"
      ],
      "translated_lines": [
        "现在，大量的满月光线正倾泻而下。"
      ]
    },
    "0/127_0": {
      "original_lines": [
        "変な名前をつけないの！"
      ],
      "translated_lines": [
        "不要起奇怪的名字！"
      ]
    },
    "0/128_0": {
      "original_lines": [
        "今は、月本来の力が甦っているの。"
      ],
      "translated_lines": [
        "现在，月亮本来的力量正在苏醒。"
      ]
    },
    "0/129_0": {
      "original_lines": [
        "穢れのない月は、穢れのない地上を妖しく",
        "照らす。"
      ],
      "translated_lines": [
        "无垢的月亮，妖异地照着无垢的",
        "大地。"
      ]
    },
    "0/130_0": {
      "original_lines": [
        "この光は貴き月の民ですら忘れた",
        "太古の記憶なのよ。"
      ],
      "translated_lines": [
        "这光亮可是连尊贵的月之民都忘记了的",
        "远古的记忆哟。"
      ]
    },
    "0/131_0": {
      "original_lines": [
        "つまり満月光線だな。",
        "見えないがびしびしと感じるぜ。"
      ],
      "translated_lines": [
        "就是说还是满月光线啦。",
        "虽然看不见不过能切身地感觉到耶。"
      ]
    },
    "0/132_0": {
      "original_lines": [
        "これじゃぁ、普通の人間は５分と持たず",
        "発狂するわ。"
      ],
      "translated_lines": [
        "照这样，普通人类用不了5分钟",
        "就会发狂啊。"
      ]
    },
    "0/133_0": {
      "original_lines": [
        "魔理沙は大丈夫かしら？"
      ],
      "translated_lines": [
        "魔理沙没事吗？"
      ]
    },
    "0/134_0": {
      "original_lines": [
        "ああ、狂うのには慣れているぜ。"
      ],
      "translated_lines": [
        "啊啊，我都习惯发狂了。"
      ]
    },
    "0/135_0": {
      "original_lines": [
        "でも、これはどういうことなんだ？"
      ],
      "translated_lines": [
        "不过，这算怎么一回事？"
      ]
    },
    "0/136_0": {
      "original_lines": [
        "なんで今、満月なんだ。"
      ],
      "translated_lines": [
        "为什么现在，是满月啊。"
      ]
    },
    "0/137_0": {
      "original_lines": [
        "永琳の術で穢れのない月と穢れのない地上は",
        "隔離された。"
      ],
      "translated_lines": [
        "永琳的法术把无垢的月亮和无垢的大地",
        "隔离了。"
      ]
    },
    "0/138_0": {
      "original_lines": [
        "私はここにいる事で、地上からも月からも",
        "身を隠す事が出来る様になったわ。"
      ],
      "translated_lines": [
        "我只要在这里，就可以",
        "从地上和月球隐身了。"
      ]
    },
    "0/139_0": {
      "original_lines": [
        "大げさなかくれんぼだな。"
      ],
      "translated_lines": [
        "好夸张的捉迷藏啊。"
      ]
    },
    "0/140_0": {
      "original_lines": [
        "でもね。"
      ],
      "translated_lines": [
        "不过呢。"
      ]
    },
    "0/141_0": {
      "original_lines": [
        "永琳のこの術は完全だけど、あまり",
        "好きじゃないわ。"
      ],
      "translated_lines": [
        "虽说永琳的法术是完美的，我可",
        "不怎么喜欢。"
      ]
    },
    "0/142_0": {
      "original_lines": [
        "ここには誰も居ない。",
        "誰も訪れない。"
      ],
      "translated_lines": [
        "这里没有任何人。",
        "谁也不会来。"
      ]
    },
    "0/143_0": {
      "original_lines": [
        "退屈過ぎて死にそうだわ。"
      ],
      "translated_lines": [
        "闷得要死啊。"
      ]
    },
    "0/144_0": {
      "original_lines": [
        "穢れのない地上には誰もいない。"
      ],
      "translated_lines": [
        "在无垢的大地上没有任何人。"
      ]
    },
    "0/145_0": {
      "original_lines": [
        "月人らしいものの見方ね。"
      ],
      "translated_lines": [
        "真是月人特有的视角。"
      ]
    },
    "0/146_0": {
      "original_lines": [
        "丁度良いじゃないか。"
      ],
      "translated_lines": [
        "这不正好吗？"
      ]
    },
    "0/147_0": {
      "original_lines": [
        "穢い私達がたっぷり遊んで、それから",
        "連れ出してやるよ。"
      ],
      "translated_lines": [
        "污秽的我们好好地陪你玩，然后",
        "把你带出去。"
      ]
    },
    "0/148_0": {
      "original_lines": [
        "まぁ、私はここの生まれじゃないから、"
      ],
      "translated_lines": [
        "嘛，反正我不是这里出生的，"
      ]
    },
    "0/149_0": {
      "original_lines": [
        "私を連れ出すのは本当に大変な事よ。"
      ],
      "translated_lines": [
        "要把我带出去可真的很费力哦。"
      ]
    },
    "0/150_0": {
      "original_lines": [
        "……大昔にも同じ様なやり取りをした",
        "事があるわ。"
      ],
      "translated_lines": [
        "……很久以前就有过",
        "类似的对话。"
      ]
    },
    "0/151_0": {
      "original_lines": [
        "まぁ、私は満月なんてどうでもいいんだがな。"
      ],
      "translated_lines": [
        "嘛，对我来说满月如何都无所谓啊。"
      ]
    },
    "0/152_0": {
      "original_lines": [
        "こいつが満月が無いと困るって駄々を",
        "こねるんでねぇ。"
      ],
      "translated_lines": [
        "只是这家伙却会撒娇说",
        "没有满月真苦恼。"
      ]
    },
    "0/153_0": {
      "original_lines": [
        "駄々をこねるどころじゃないわ。"
      ],
      "translated_lines": [
        "哪有撒娇。"
      ]
    },
    "0/154_0": {
      "original_lines": [
        "余りふざけたまねをしてると、天罰が",
        "下るわよ。"
      ],
      "translated_lines": [
        "你要是太胡闹，天罚",
        "会降临哦。"
      ]
    },
    "0/155_0": {
      "original_lines": [
        "天罰は怖いわね。"
      ],
      "translated_lines": [
        "天罚可恐怖呢。"
      ]
    },
    "0/156_0": {
      "original_lines": [
        "でも、私が地上にいるのも天罰なの。"
      ],
      "translated_lines": [
        "不过，我到地上来也是因为受了天罚。"
      ]
    },
    "0/157_0": {
      "original_lines": [
        "そうだ、こんな私を連れ出そうとする",
        "人にはいつも難題を与えてきたわ。"
      ],
      "translated_lines": [
        "对了，我一直是给想要带我出去的人",
        "出难题的。"
      ]
    },
    "0/158_0": {
      "original_lines": [
        "難題？"
      ],
      "translated_lines": [
        "难题？"
      ]
    },
    "0/159_0": {
      "original_lines": [
        "それを解けばお前を連れ出せると",
        "いうのか？"
      ],
      "translated_lines": [
        "是说解开那个",
        "就能带你出去了吗？"
      ]
    },
    "0/160_0": {
      "original_lines": [
        "今まで、何人もの人間が敗れ去って",
        "いった五つの問題。"
      ],
      "translated_lines": [
        "到现在为止，已经使无数人败退的",
        "这五个难题。"
      ]
    },
    "0/161_0": {
      "original_lines": [
        "貴方達に幾つ解けるかしら？"
      ],
      "translated_lines": [
        "你们能解开多少呢？"
      ]
    },
    "2/60_0": {
      "original_lines": [
        "ああもう。"
      ],
      "translated_lines": [
        "啊真是的。"
      ]
    },
    "2/61_0": {
      "original_lines": [
        "こっちに来させちゃ駄目だって言ってるのに。"
      ],
      "translated_lines": [
        "我明明都已经说了不能放你们来这里的。"
      ]
    },
    "2/62_0": {
      "original_lines": [
        "なんだか知らんが"
      ],
      "translated_lines": [
        "虽然不知道为什么。"
      ]
    },
    "2/63_0": {
      "original_lines": [
        "良い方に向かっている感じね。"
      ],
      "translated_lines": [
        "事态正朝好的方向发展的感觉。"
      ]
    },
    "3/60_0": {
      "original_lines": [
        "なんて事！"
      ],
      "translated_lines": [
        "怎么回事！"
      ]
    },
    "3/61_0": {
      "original_lines": [
        "そう、夜を止めていたのは……、"
      ],
      "translated_lines": [
        "原来，停止夜晚的人……，"
      ]
    },
    "3/62_0": {
      "original_lines": [
        "貴方達だったのね。"
      ],
      "translated_lines": [
        "就是你们啊。"
      ]
    },
    "6/60_0": {
      "original_lines": [
        "貴方達が作った半端な永遠の夜なんて……"
      ],
      "translated_lines": [
        "你们所做出的这种半吊子的永远之夜……"
      ]
    },
    "7/60_0": {
      "original_lines": [
        "私の永遠を操る術で全て破って見せる。"
      ],
      "translated_lines": [
        "我就用操纵永远的力量来打破给你们看。"
      ]
    },
    "8/60_0": {
      "original_lines": [
        "夜明けはすぐそこにあるはずよ。"
      ],
      "translated_lines": [
        "黎明应该很快就会到来了。"
      ]
    },
    "9/60_0": {
      "original_lines": [
        "どう？",
        "これで永夜の術は破れて、夜は明ける！"
      ],
      "translated_lines": [
        "怎么样？",
        "这样永夜之术就要被打破，夜幕终将破晓！"
      ]
    }
  }
}
