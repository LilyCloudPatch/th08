{
  "schema": "lilypatch.text.v1",
  "target_id": "th08_100d",
  "resource": "data/msg3c.dat",
  "entries": {
    "0/60_0": {
      "original_lines": [
        "よく見てみな。悪魔達よ。"
      ],
      "translated_lines": [
        "好好看着。恶魔们。"
      ]
    },
    "0/60_1": {
      "original_lines": [
        "達って、ねぇ。"
      ],
      "translated_lines": [
        "“们”，吗。"
      ]
    },
    "0/61_0": {
      "original_lines": [
        "ここには何も無かった。",
        "そう見えるだろう？"
      ],
      "translated_lines": [
        "这里不曾有过什么。",
        "看起来是这样吧？"
      ]
    },
    "0/62_0": {
      "original_lines": [
        "って、ここは人間の里でしょ？"
      ],
      "translated_lines": [
        "等等，这里是人类村落吧？"
      ]
    },
    "0/63_0": {
      "original_lines": [
        "ああ、私はあんまり来る事は無いけど、",
        "咲夜はよく来ているのかしら？"
      ],
      "translated_lines": [
        "啊啊，虽然我很少来，",
        "不过咲夜常来吧？"
      ]
    },
    "0/64_0": {
      "original_lines": [
        "ええ、うちのお屋敷の道具は人間製のもの",
        "も結構有りますわ。"
      ],
      "translated_lines": [
        "嗯，我们洋馆中的道具也有不少",
        "是人类制造的。"
      ]
    },
    "0/65_0": {
      "original_lines": [
        "よく見て……。",
        "見ての通り、ここには何も無かったんだよ。"
      ],
      "translated_lines": [
        "好好看看吧……。",
        "正如你们看到的一样，这里不曾有过什么。"
      ]
    },
    "0/66_0": {
      "original_lines": [
        "いいから、さっさと通り過ぎな。"
      ],
      "translated_lines": [
        "好了，你们就快点过去吧。"
      ]
    },
    "0/67_0": {
      "original_lines": [
        "なんか嫌な態度ね。"
      ],
      "translated_lines": [
        "让人不高兴的态度呢。"
      ]
    },
    "0/68_0": {
      "original_lines": [
        "里と人間をどこやったのかしら？"
      ],
      "translated_lines": [
        "村庄和人们被你弄到哪里去了？"
      ]
    },
    "0/69_0": {
      "original_lines": [
        "判らんのか？",
        "そもそも、人間は居なかった事にした。"
      ],
      "translated_lines": [
        "不懂吗？",
        "我让人类不曾在这里存在，"
      ]
    },
    "0/70_0": {
      "original_lines": [
        "今、ここの里の歴史は全て私が",
        "保護している。"
      ],
      "translated_lines": [
        "这个村庄全部的历史现在由我",
        "保护着。"
      ]
    },
    "0/71_0": {
      "original_lines": [
        "咲夜。"
      ],
      "translated_lines": [
        "咲夜。"
      ]
    },
    "0/72_0": {
      "original_lines": [
        "妹の家庭教師に良いんじゃない？",
        "郷土歴史学の先生って感じで。"
      ],
      "translated_lines": [
        "这家伙当妹妹的家庭教师不错吧？",
        "感觉像乡土历史学老师。"
      ]
    },
    "0/73_0": {
      "original_lines": [
        "うちにはもう知識人は要りませんわ……。"
      ],
      "translated_lines": [
        "我们家里不需要再有知识分子了……。"
      ]
    },
    "0/74_0": {
      "original_lines": [
        "いいか、もう一度言う。"
      ],
      "translated_lines": [
        "好了，我再讲一遍。"
      ]
    },
    "0/75_0": {
      "original_lines": [
        "ここには元々何も無かった。",
        "人間も人間の里もだ。"
      ],
      "translated_lines": [
        "这里原本就不曾有过什么。",
        "不管是人类还是人类村落。"
      ]
    },
    "0/76_0": {
      "original_lines": [
        "どうも、その言い方がひっかかるのよね。"
      ],
      "translated_lines": [
        "这种说法真的让人很在意呢。"
      ]
    },
    "0/77_0": {
      "original_lines": [
        "お嬢様。",
        "少々時間を頂けますか？"
      ],
      "translated_lines": [
        "大小姐。",
        "可以借我点时间吗？"
      ]
    },
    "0/78_0": {
      "original_lines": [
        "急いでるんだけどね。物凄く。"
      ],
      "translated_lines": [
        "很急呢。非常急。"
      ]
    },
    "0/79_0": {
      "original_lines": [
        "そこの悪魔の歴史も私が頂こうか？"
      ],
      "translated_lines": [
        "那边的恶魔的历史也给我如何？"
      ]
    },
    "0/80_0": {
      "original_lines": [
        "ふん、偉そうね。",
        "ワーハクタクの癖に。"
      ],
      "translated_lines": [
        "哼，看起来真了不起啊。",
        "不过是只半兽白泽罢了。"
      ]
    },
    "0/81_0": {
      "original_lines": [
        "歴史ばっかリ見ているお前には、",
        "運命は変えられないよ。"
      ],
      "translated_lines": [
        "只会看着历史的你，",
        "可是没办法改变命运的。"
      ]
    },
    "0/82_0": {
      "original_lines": [
        "お嬢様。",
        "時間を頂いてもいいのですね？"
      ],
      "translated_lines": [
        "大小姐。",
        "可以给我点时间吗？"
      ]
    },
    "0/83_0": {
      "original_lines": [
        "しょうがないわねぇ。",
        "ちょっとなら、私の時間も使っても良いわ。"
      ],
      "translated_lines": [
        "真没办法。",
        "只要一点点的话，让你用点我的时间也可以。"
      ]
    },
    "1/60_0": {
      "original_lines": [
        "さぁ、すっきりしたところで先を",
        "急ぎましょう。"
      ],
      "translated_lines": [
        "好了，已经爽快了",
        "快点赶路吧。"
      ]
    },
    "1/61_0": {
      "original_lines": [
        "まだ、里は元に戻ってないけど",
        "もうすっきりしたの？"
      ],
      "translated_lines": [
        "村庄还没恢复成原来的样子",
        "就爽快了吗？"
      ]
    },
    "1/62_0": {
      "original_lines": [
        "もうすっきりしたわ。きれいさっぱり。"
      ],
      "translated_lines": [
        "爽快了。很彻底。"
      ]
    },
    "1/63_0": {
      "original_lines": [
        "まぁいいけど、こいつのお陰ですっかり妖気の",
        "上流の方向を見失ったわ。"
      ],
      "translated_lines": [
        "嘛，也好，但因为这家伙",
        "彻底迷失了妖气的上游的方向了。"
      ]
    },
    "1/64_0": {
      "original_lines": [
        "咲夜は、行き先が分かってるのかしら。"
      ],
      "translated_lines": [
        "咲夜，知道目的地吗。"
      ]
    },
    "1/65_0": {
      "original_lines": [
        "きれいさっぱりですわ。",
        "でもほら、こんなときに便利な奴がいます。"
      ],
      "translated_lines": [
        "完全不明白。",
        "不过您看，现在有个方便的家伙在啊。"
      ]
    },
    "1/66_0": {
      "original_lines": [
        "あー？満月の異変の原因？"
      ],
      "translated_lines": [
        "啊—？满月异变的原因？"
      ]
    },
    "1/67_0": {
      "original_lines": [
        "それは、あいつの仕業だろう。",
        "こんな事出来る奴なんてそうそう居ないしな。"
      ],
      "translated_lines": [
        "那是那家伙干的吧。",
        "做得到这种事的人可不多呢。"
      ]
    },
    "1/68_0": {
      "original_lines": [
        "知識人は役に立つわね。",
        "家にはもう要らないけど。"
      ],
      "translated_lines": [
        "知识分子真有用呢。",
        "虽然家里不需要。"
      ]
    },
    "1/69_0": {
      "original_lines": [
        "家の知識人は本ばっかり読んでて、",
        "あんまり役に立っていない気が……"
      ],
      "translated_lines": [
        "总觉得家里的知识分子老是在看书，",
        "不怎么有用……"
      ]
    },
    "1/70_0": {
      "original_lines": [
        "ムダ知識が豊富なのですよ。",
        "もう要らないけど。"
      ],
      "translated_lines": [
        "没用的知识很丰富啊。",
        "虽然不需要。"
      ]
    },
    "2/61_0": {
      "original_lines": [
        "お前達か。",
        "こんな真夜中に里を襲おうとする奴は。"
      ],
      "translated_lines": [
        "就是你们吗。",
        "在这样的深夜里企图袭击村落的家伙。"
      ]
    },
    "2/62_0": {
      "original_lines": [
        "お嬢様。",
        "こんなところ、さっさと通り抜けましょう。"
      ],
      "translated_lines": [
        "大小姐。",
        "这种地方就赶快通过吧。"
      ]
    },
    "2/63_0": {
      "original_lines": [
        "まぁ、別に餓えてはいないけど……"
      ],
      "translated_lines": [
        "嘛，反正也不饿……"
      ]
    },
    "2/64_0": {
      "original_lines": [
        "まったく、ここの人間が居なくなったら",
        "残るは妖怪と変な人間だけになるじゃないか！"
      ],
      "translated_lines": [
        "真是的，这里没有人类居住后",
        "就只剩下妖怪和怪人了吗！"
      ]
    },
    "3/61_0": {
      "original_lines": [
        "むむ、お前達何もんだ？"
      ],
      "translated_lines": [
        "唔唔，你们是什么人？"
      ]
    },
    "3/62_0": {
      "original_lines": [
        "ふん。もう後が無いんじゃないかい？"
      ],
      "translated_lines": [
        "哼。已经无路可退了吧？"
      ]
    },
    "3/63_0": {
      "original_lines": [
        "お嬢様！",
        "少々お戯れが過ぎますよ。"
      ],
      "translated_lines": [
        "大小姐！",
        "玩得有点太过火了。"
      ]
    }
  }
}
