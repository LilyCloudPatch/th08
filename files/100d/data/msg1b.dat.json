{
  "schema": "lilypatch.text.v1",
  "target_id": "th08_100d",
  "resource": "data/msg1b.dat",
  "entries": {
    "0/60_0": {
      "original_lines": [
        "ああ、月が綺麗だな。"
      ],
      "translated_lines": [
        "啊啊，月亮真美啊。"
      ]
    },
    "0/61_0": {
      "original_lines": [
        "えっ、あんたにはそう見えるの？"
      ],
      "translated_lines": [
        "哎，你是这么觉得的吗？"
      ]
    },
    "0/62_0": {
      "original_lines": [
        "ふん、綺麗じゃないか。",
        "こういう月ってなんていったっけ？待宵？"
      ],
      "translated_lines": [
        "嗯，不美吗？",
        "这种月亮叫什么来的？待宵？"
      ]
    },
    "0/63_0": {
      "original_lines": [
        "呑気で良いわね。",
        "月見が楽しめて、人手が足りてたら……"
      ],
      "translated_lines": [
        "真有闲情雅兴啊。",
        "如果我能高高兴兴赏月，人手足够的话……"
      ]
    },
    "0/64_0": {
      "original_lines": [
        "あんたなんか絶対に連れ出さないわよ。"
      ],
      "translated_lines": [
        "我绝对不会拉你这种家伙出来的。"
      ]
    },
    "0/64_1": {
      "original_lines": [
        "月の見える夜は楽しまないと駄目じゃない。"
      ],
      "translated_lines": [
        "能看到月亮的夜晚不高兴怎么行。"
      ]
    },
    "0/125_0": {
      "original_lines": [
        "ねぇ。お二方。"
      ],
      "translated_lines": [
        "是吧。两位。"
      ]
    },
    "0/126_0": {
      "original_lines": [
        "楽しんでるぜ。私はな。"
      ],
      "translated_lines": [
        "正高兴着呢。我啊。"
      ]
    },
    "0/127_0": {
      "original_lines": [
        "あら、私も楽しんでるわよ。",
        "魔理沙、あなた以上はね。"
      ],
      "translated_lines": [
        "哎呀，我也正高兴着呢。",
        "魔理沙，比你还高兴呢。"
      ]
    },
    "0/128_0": {
      "original_lines": [
        "さっきといってる事が違うじゃん。"
      ],
      "translated_lines": [
        "和你刚才说的不一样嘛。"
      ]
    },
    "0/129_0": {
      "original_lines": [
        "違うの。",
        "私が楽しんでるのは月見じゃなくて、"
      ],
      "translated_lines": [
        "是不一样。",
        "我高兴的事不是赏月，"
      ]
    },
    "0/130_0": {
      "original_lines": [
        "蛍見、だろう？"
      ],
      "translated_lines": [
        "是赏萤火虫，对吧？"
      ]
    },
    "0/131_0": {
      "original_lines": [
        "惜しいわね。あなたにしては。"
      ],
      "translated_lines": [
        "真可惜啊。你猜错了。"
      ]
    },
    "0/132_0": {
      "original_lines": [
        "……来ないのなら私から行くよ！"
      ],
      "translated_lines": [
        "……你们不来我可要过去喽！"
      ]
    },
    "0/133_0": {
      "original_lines": [
        "蛍狩よ。"
      ],
      "translated_lines": [
        "是抓萤火虫哦。"
      ]
    },
    "1/60_0": {
      "original_lines": [
        "蛍狩って蛍を捕まえる事であって、",
        "やっつける事じゃないぜ。"
      ],
      "translated_lines": [
        "抓萤火虫是要去逮住他们，",
        "不是要干掉他们啊。"
      ]
    },
    "1/61_0": {
      "original_lines": [
        "私は捕まえる気だったのに、あんたが",
        "潰したんでしょ？"
      ],
      "translated_lines": [
        "我是想要逮的，是你给打烂的",
        "不是吗？"
      ]
    },
    "1/62_0": {
      "original_lines": [
        "ったく、やれやれだぜ……"
      ],
      "translated_lines": [
        "真是，哎呀呀……"
      ]
    },
    "1/63_0": {
      "original_lines": [
        "私は蛍を避けただけだ。勘違いするな。"
      ],
      "translated_lines": [
        "我只是在躲萤火虫。别搞错。"
      ]
    }
  }
}
