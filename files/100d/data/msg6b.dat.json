{
  "schema": "lilypatch.text.v1",
  "target_id": "th08_100d",
  "resource": "data/msg6b.dat",
  "entries": {
    "0/60_0": {
      "original_lines": [
        "何度も出てきたり逃げたりしていたようだが、",
        "それは焦りか？"
      ],
      "translated_lines": [
        "看你几次出来又逃走的，",
        "你是着急了吗？"
      ]
    },
    "0/121_0": {
      "original_lines": [
        "焦り？",
        "貴方達は愚かねぇ。"
      ],
      "translated_lines": [
        "着急？",
        "你们真愚蠢啊。"
      ]
    },
    "0/122_0": {
      "original_lines": [
        "ここまで誘導されてきた事にも",
        "気が付かないのかしら。"
      ],
      "translated_lines": [
        "都没注意到自己是被",
        "引诱到这里的么？"
      ]
    },
    "0/123_0": {
      "original_lines": [
        "魔理沙、周りを見て！"
      ],
      "translated_lines": [
        "魔理沙，看看周围！"
      ]
    },
    "0/124_0": {
      "original_lines": [
        "見てるって。",
        "何時の間にか外だな。"
      ],
      "translated_lines": [
        "我看着呢。",
        "不知不觉到了外面啊。"
      ]
    },
    "0/125_0": {
      "original_lines": [
        "そう、外よ。",
        "貴方達は永い廊下に導かれてここまで来た。"
      ],
      "translated_lines": [
        "对了，是外面哟。",
        "你们受永远之廊的引导到了这里。"
      ]
    },
    "0/126_0": {
      "original_lines": [
        "どう？",
        "外の空気は。"
      ],
      "translated_lines": [
        "如何？",
        "外面的空气。"
      ]
    },
    "0/127_0": {
      "original_lines": [
        "というか、空気はあるんだな。",
        "地上の外も。"
      ],
      "translated_lines": [
        "说起来，还有空气啊。",
        "地上之外。"
      ]
    },
    "0/128_0": {
      "original_lines": [
        "魔理沙！おかしいわよ。",
        "この月も星も……。"
      ],
      "translated_lines": [
        "魔理沙！很奇怪啊。",
        "这月亮这星星都……。"
      ]
    },
    "0/129_0": {
      "original_lines": [
        "さっきから、魔理沙魔理沙うるさいなぁ。",
        "結局人が居なきゃ何も出来ないのかよ。"
      ],
      "translated_lines": [
        "你从刚才就魔理沙魔理沙的吵死啦。",
        "结果人不在你就什么也干不了吗？"
      ]
    },
    "0/130_0": {
      "original_lines": [
        "ふふふ。",
        "こうやって、月に向う人間を偽の月に繋ぐ。"
      ],
      "translated_lines": [
        "哼哼哼。如此一来，",
        "朝向月亮的人类就被诱导到虚假的月亮上去。"
      ]
    },
    "0/131_0": {
      "original_lines": [
        "月と地上を結ぶ道は、私の手によって",
        "切られたわ。"
      ],
      "translated_lines": [
        "连接月亮与地上的路，就被我",
        "切断了。"
      ]
    },
    "0/132_0": {
      "original_lines": [
        "これで、地上人は月に辿り着けない。"
      ],
      "translated_lines": [
        "这样，地上人就到不了月球了。"
      ]
    },
    "0/133_0": {
      "original_lines": [
        "そして月の民は、姫を探し出せない。"
      ],
      "translated_lines": [
        "然后月之民也就找不到公主了。"
      ]
    },
    "0/134_0": {
      "original_lines": [
        "姫？",
        "そうか、お前達は月の民か。"
      ],
      "translated_lines": [
        "公主？",
        "是嘛，你们是月之民啊。"
      ]
    },
    "0/135_0": {
      "original_lines": [
        "なんでそう思うの？"
      ],
      "translated_lines": [
        "你为什么那么想？"
      ]
    },
    "0/136_0": {
      "original_lines": [
        "狂ってる奴は大抵、月が原因だ。",
        "深い意味は無いぜ。"
      ],
      "translated_lines": [
        "发狂的家伙大都是，因为月亮。",
        "没有深层的含义。"
      ]
    },
    "0/137_0": {
      "original_lines": [
        "そう、姫も私も鈴仙も月の生まれよ。"
      ],
      "translated_lines": [
        "不错，公主，我和铃仙都是生在月球的。"
      ]
    },
    "0/138_0": {
      "original_lines": [
        "でも、もう帰らない事にしたわ。",
        "ずっと昔にね。"
      ],
      "translated_lines": [
        "但是，我们决定不回去了。",
        "在很久以前就决定了。"
      ]
    },
    "0/139_0": {
      "original_lines": [
        "別にあんたらが帰ろうがどうだろうが",
        "関係無いがな。"
      ],
      "translated_lines": [
        "你们要不要回去",
        "和我们没什么关系啊。"
      ]
    },
    "0/140_0": {
      "original_lines": [
        "月の民は、月を見て楽しむ民の事を",
        "考えているのか？"
      ],
      "translated_lines": [
        "月之民有为想高兴赏月的人们",
        "考虑过吗？"
      ]
    },
    "0/141_0": {
      "original_lines": [
        "そんなもの……。"
      ],
      "translated_lines": [
        "那种事……。"
      ]
    },
    "0/142_0": {
      "original_lines": [
        "地上人も見てるだけなら問題",
        "なかったのに……。"
      ],
      "translated_lines": [
        "地上人只是要看看的话",
        "本来也没问题……。"
      ]
    },
    "0/143_0": {
      "original_lines": [
        "わざわざ月にまで来ようとしたり、",
        "挙句の果てに、"
      ],
      "translated_lines": [
        "可偏偏有人要特地跑到月亮上来，",
        "最终，"
      ]
    },
    "0/144_0": {
      "original_lines": [
        "旗を立てて、自分の物だ、みたいに",
        "いう愚かな地上人が出てくる。"
      ],
      "translated_lines": [
        "还插上了旗子，就好像说“这是我们的东西了”",
        "如此愚蠢的地上人。"
      ]
    },
    "0/145_0": {
      "original_lines": [
        "そんなだから何時まで経っても、",
        "地上人は下賎なのよ。"
      ],
      "translated_lines": [
        "就因为这样，不论过多长时间，",
        "地上人都如此下贱。"
      ]
    },
    "0/146_0": {
      "original_lines": [
        "ふん。",
        "私達はそんな真似はしてないわ。"
      ],
      "translated_lines": [
        "哼。",
        "我们可没做过那种事。"
      ]
    },
    "0/147_0": {
      "original_lines": [
        "地上に満月が無いと困る民も居る。"
      ],
      "translated_lines": [
        "地上也有人为没有满月而发愁呢。"
      ]
    },
    "0/148_0": {
      "original_lines": [
        "そんな地上であなたが満月を隠せば、",
        "それなりの報復を受ける事も考えているの？"
      ],
      "translated_lines": [
        "你们想过从地上把满月藏起来，",
        "也会受到相应的报复吗？"
      ]
    },
    "0/149_0": {
      "original_lines": [
        "ああ、いいのよ。",
        "術はもう済んだから。"
      ],
      "translated_lines": [
        "啊啊，无所谓的。",
        "法术已经完成了。"
      ]
    },
    "0/150_0": {
      "original_lines": [
        "朝になれば満月は返してあげる。",
        "といっても、元々私達のものだけどね。"
      ],
      "translated_lines": [
        "到了早上就把满月还给你们。",
        "虽是这样说，那本来就是我们的东西呢。"
      ]
    },
    "0/151_0": {
      "original_lines": [
        "そうかい。"
      ],
      "translated_lines": [
        "是吗。"
      ]
    },
    "0/152_0": {
      "original_lines": [
        "じゃぁ、残りは今まで隠していた分の",
        "報復だけ、という事だな。"
      ],
      "translated_lines": [
        "那么，剩下的就只有把满月藏到现在的",
        "所应受到的报复了吧。"
      ]
    },
    "0/153_0": {
      "original_lines": [
        "そうね。",
        "どの位痛みつければ良いのかしらね。"
      ],
      "translated_lines": [
        "对呀。",
        "究竟要弄到你多疼才好呢。"
      ]
    },
    "0/154_0": {
      "original_lines": [
        "あらあら、痛いのは嫌だわ。"
      ],
      "translated_lines": [
        "哎呀哎呀，我讨厌疼呢。"
      ]
    },
    "0/155_0": {
      "original_lines": [
        "あいにく、私は薬学の心得があるから、",
        "多少の怪我なら大丈夫だけど。"
      ],
      "translated_lines": [
        "不凑巧啊，因为我有药学的心得，",
        "一点点伤算不了什么的。"
      ]
    },
    "0/156_0": {
      "original_lines": [
        "それは有難い事で。",
        "私達の滋養回復でもお願いするか。"
      ],
      "translated_lines": [
        "那太难得了。",
        "我们的营养回复也拜托你吧。"
      ]
    },
    "0/157_0": {
      "original_lines": [
        "それにね、薬は攻撃にも使えるのよ！"
      ],
      "translated_lines": [
        "而且，药也能用在攻击上哟！"
      ]
    },
    "2/60_0": {
      "original_lines": [
        "ふふふ。"
      ],
      "translated_lines": [
        "呵呵呵。"
      ]
    },
    "2/61_0": {
      "original_lines": [
        "無事ついて来てるようね。"
      ],
      "translated_lines": [
        "你们顺利跟上来了。"
      ]
    },
    "2/62_0": {
      "original_lines": [
        "魔理沙！",
        "こいつを撃つのよ。"
      ],
      "translated_lines": [
        "魔理沙！",
        "攻击这家伙。"
      ]
    },
    "2/63_0": {
      "original_lines": [
        "んなもん、言われなくても判ってるぜ。"
      ],
      "translated_lines": [
        "不用你说我也知道。"
      ]
    },
    "3/60_0": {
      "original_lines": [
        "何遊んでるのよ！"
      ],
      "translated_lines": [
        "你在玩什么啊！"
      ]
    },
    "3/61_0": {
      "original_lines": [
        "永琳、私の力でもう一度だけチャンスをあげる。"
      ],
      "translated_lines": [
        "永琳，用我的力量再给你一次机会。"
      ]
    },
    "3/62_0": {
      "original_lines": [
        "これで負けたらその時は……。"
      ],
      "translated_lines": [
        "要是这样再失败的话，到时候……"
      ]
    },
    "3/63_0": {
      "original_lines": [
        "そこの野良猫！"
      ],
      "translated_lines": [
        "那里的野猫！"
      ]
    },
    "3/64_0": {
      "original_lines": [
        "私の力で作られた薬と永琳の本当の力、",
        "一生忘れないものになるよ！"
      ],
      "translated_lines": [
        "用我的力量所做出的药和永琳真正的力量，",
        "会让你们一生都难忘的！"
      ]
    }
  }
}
