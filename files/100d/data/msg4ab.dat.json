{
  "schema": "lilypatch.text.v1",
  "target_id": "th08_100d",
  "resource": "data/msg4ab.dat",
  "entries": {
    "0/60_0": {
      "original_lines": [
        "ちょっと待て！"
      ],
      "translated_lines": [
        "稍等！"
      ]
    },
    "0/121_0": {
      "original_lines": [
        "何だ、何時までも夜が明けないから",
        "おかしいと思ったら、"
      ],
      "translated_lines": [
        "到什么时候天都不亮",
        "正觉得奇怪，"
      ]
    },
    "0/121_1": {
      "original_lines": [
        "魔理沙の仕業ね。"
      ],
      "translated_lines": [
        "原来是魔理沙干的啊。"
      ]
    },
    "0/121_2": {
      "original_lines": [
        "おい、誤解だ。",
        "悪いのはこいつ一人だぜ。"
      ],
      "translated_lines": [
        "喂，这是误会。",
        "干坏事的只有这家伙。"
      ]
    },
    "0/122_0": {
      "original_lines": [
        "何よ。",
        "あんたも同罪でしょ？"
      ],
      "translated_lines": [
        "什么嘛。",
        "你也是同罪吧？"
      ]
    },
    "0/123_0": {
      "original_lines": [
        "こんな事して……、",
        "一体何を企んでるのよ。"
      ],
      "translated_lines": [
        "干出这种事来……，",
        "你到底有什么企图啊。"
      ]
    },
    "0/124_0": {
      "original_lines": [
        "あれだな、ほら。",
        "霊夢、なんと言うか……。"
      ],
      "translated_lines": [
        "那个啊，你看。",
        "灵梦，怎么说呢……。"
      ]
    },
    "0/125_0": {
      "original_lines": [
        "歯切れが悪いわね。",
        "いつもみたいに言えばいいじゃない。"
      ],
      "translated_lines": [
        "怎么吞吞吐吐的了。",
        "像平时一样说话不就行了。"
      ]
    },
    "0/126_0": {
      "original_lines": [
        "邪魔だ、そこをどけ！",
        "ってね。"
      ],
      "translated_lines": [
        "碍事，闪一边去！",
        "这么说不就好了。"
      ]
    },
    "0/127_0": {
      "original_lines": [
        "馬鹿！",
        "こいつを怒らせると不味いぜ。"
      ],
      "translated_lines": [
        "笨蛋！",
        "要是惹怒了这家伙可就糟了。"
      ]
    },
    "0/128_0": {
      "original_lines": [
        "私を怒らせる事自体が不味い事でしょ？"
      ],
      "translated_lines": [
        "能让我发怒的事本身就是很糟糕的事了吧？"
      ]
    },
    "0/129_0": {
      "original_lines": [
        "今日はちょっと懲らしめてやらないと",
        "いけないわね。"
      ],
      "translated_lines": [
        "今天不稍微惩罚一下你",
        "看来是不行了吧。"
      ]
    },
    "0/130_0": {
      "original_lines": [
        "ふん。",
        "あんた、後ろ見てもなんとも思わないの？"
      ],
      "translated_lines": [
        "哼。",
        "你，看看身后就没有什么想法？"
      ]
    },
    "0/131_0": {
      "original_lines": [
        "もう、歪な月もこんなに判り易く",
        "なってるじゃない！"
      ],
      "translated_lines": [
        "歪曲的月亮",
        "都已经如此清晰可见了！"
      ]
    },
    "0/132_0": {
      "original_lines": [
        "ああ！"
      ],
      "translated_lines": [
        "啊啊！"
      ]
    },
    "0/133_0": {
      "original_lines": [
        "この月も、あんたらの仕業ね。"
      ],
      "translated_lines": [
        "这月亮，也是你们搞的鬼吧。"
      ]
    },
    "0/134_0": {
      "original_lines": [
        "ああ、もういいぜ。諦めたよ。"
      ],
      "translated_lines": [
        "啊啊，好啦。我放弃了。"
      ]
    },
    "0/135_0": {
      "original_lines": [
        "そうだ。",
        "この終らない夜も、欠けて歪な月も、"
      ],
      "translated_lines": [
        "不错。",
        "这没完没了的夜晚，这残缺歪曲的月亮，"
      ]
    },
    "0/136_0": {
      "original_lines": [
        "消えた人間の里も、",
        "お地蔵さんに傘かぶせて廻ったのも、"
      ],
      "translated_lines": [
        "消失的人类村落，",
        "还有跑了一圈给很多地藏都打了伞，"
      ]
    },
    "0/137_0": {
      "original_lines": [
        "全てはアリスがやった。"
      ],
      "translated_lines": [
        "全部都是爱丽丝干的。"
      ]
    },
    "0/138_0": {
      "original_lines": [
        "さぁ、そこをどきな！"
      ],
      "translated_lines": [
        "快，给我从那里让开！"
      ]
    },
    "0/139_0": {
      "original_lines": [
        "まぁいいけどね。"
      ],
      "translated_lines": [
        "那倒也行。"
      ]
    },
    "0/140_0": {
      "original_lines": [
        "月の光を蓄えたこの竹林で、"
      ],
      "translated_lines": [
        "在这积蓄了月光的竹林里，"
      ]
    },
    "0/141_0": {
      "original_lines": [
        "あんたらは、光る竹の一つになる。",
        "美しいわね。"
      ],
      "translated_lines": [
        "你们也将成为一根发光的竹子。",
        "真美啊。"
      ]
    },
    "0/142_0": {
      "original_lines": [
        "その言葉、ちょっと屈折させて",
        "お返ししますわ。"
      ],
      "translated_lines": [
        "那些话，我也稍微改改",
        "还给你。"
      ]
    },
    "0/143_0": {
      "original_lines": [
        "さぁ！",
        "終らない夜は、ここでお終いよ！"
      ],
      "translated_lines": [
        "来吧！",
        "无尽之夜，到这里就是尽头！"
      ]
    },
    "1/60_0": {
      "original_lines": [
        "さぁ急ぐぜ。"
      ],
      "translated_lines": [
        "快走吧。"
      ]
    },
    "1/61_0": {
      "original_lines": [
        "目的地が見えてきたわ。"
      ],
      "translated_lines": [
        "看到目的地了。"
      ]
    },
    "1/62_0": {
      "original_lines": [
        "仕様が無いわね。",
        "悪巧みも程ほどにするのよ。"
      ],
      "translated_lines": [
        "没办法啊。",
        "算计人也得有个限度啊。"
      ]
    },
    "1/63_0": {
      "original_lines": [
        "なんか言った？"
      ],
      "translated_lines": [
        "你说什么？"
      ]
    },
    "1/64_0": {
      "original_lines": [
        "へぇ。竹林の中にこんな大きな屋敷がある",
        "なんて、初めて知ったぜ。"
      ],
      "translated_lines": [
        "哎。竹林里有那么大个屋子",
        "我可是第一次知道。"
      ]
    },
    "1/65_0": {
      "original_lines": [
        "あー？",
        "私も初めて見たわ。"
      ],
      "translated_lines": [
        "啊—？",
        "我也是第一次看见。"
      ]
    },
    "1/66_0": {
      "original_lines": [
        "じゃぁね。",
        "良い子と負け犬はここでお帰りね。"
      ],
      "translated_lines": [
        "再见了。",
        "好孩子和丧家犬到此就回家去吧。"
      ]
    },
    "1/67_0": {
      "original_lines": [
        "霊夢、永遠の一回休みだ。",
        "じゃぁな。"
      ],
      "translated_lines": [
        "灵梦，永远轮不到你的回合了。",
        "再见了。"
      ]
    },
    "2/60_0": {
      "original_lines": [
        "あれ？",
        "逃げるなんてあいつらしくないな。"
      ],
      "translated_lines": [
        "咦？",
        "逃跑可不像那家伙的作风啊。"
      ]
    },
    "2/61_0": {
      "original_lines": [
        "追うわよ。魔理沙。"
      ],
      "translated_lines": [
        "追上去。魔理沙。"
      ]
    },
    "3/60_0": {
      "original_lines": [
        "さぁ、あんたらに、本当の結界を",
        "見せてあげるわ。"
      ],
      "translated_lines": [
        "来，让你们瞧瞧",
        "真正的结界。"
      ]
    },
    "3/61_0": {
      "original_lines": [
        "何で仕切りなおす必要があったんだよ。"
      ],
      "translated_lines": [
        "为什么还要重新布置一遍啊。"
      ]
    },
    "3/62_0": {
      "original_lines": [
        "そっちが二人だから二回！"
      ],
      "translated_lines": [
        "你们是两个人所以我要来两回！"
      ]
    }
  }
}
