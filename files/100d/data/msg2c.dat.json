{
  "schema": "lilypatch.text.v1",
  "target_id": "th08_100d",
  "resource": "data/msg2c.dat",
  "entries": {
    "0/60_0": {
      "original_lines": [
        "ちょ、ちょっと待って～！"
      ],
      "translated_lines": [
        "等，等一下～！"
      ]
    },
    "0/60_1": {
      "original_lines": [
        "急いでるのよ。",
        "動きながらなら聞いてあげるわ。"
      ],
      "translated_lines": [
        "我们很急呢。",
        "边走边讲的话倒可以听听。"
      ]
    },
    "0/60_2": {
      "original_lines": [
        "言っても止まらないくせに。",
        "でも、人間と蝙蝠。不思議な組み合わせね。"
      ],
      "translated_lines": [
        "我和你们讲了，可是你们还是不停下来。",
        "不过，人类和蝙蝠。真是不可思议的组合呢。"
      ]
    },
    "0/61_0": {
      "original_lines": [
        "人間は欲しいけど、そいつはいらない。"
      ],
      "translated_lines": [
        "虽然想要人类，但不要那个家伙。"
      ]
    },
    "0/63_0": {
      "original_lines": [
        "ふん。餓鬼が夜遊びか？"
      ],
      "translated_lines": [
        "哼。饿鬼在夜游吗？"
      ]
    },
    "0/63_1": {
      "original_lines": [
        "勿論、夜遊びよ。",
        "良い子の昼間はおねむの時間。"
      ],
      "translated_lines": [
        "当然了，夜游哦。",
        "好孩子的白天是睡觉的时间。"
      ]
    },
    "0/64_0": {
      "original_lines": [
        "夜は人狩りサービスタイムよ。"
      ],
      "translated_lines": [
        "而晚上则是猎捕人类的时间了。"
      ]
    },
    "0/66_0": {
      "original_lines": [
        "悪いけど急いでるんだ。",
        "さっさとやられてくれないか？"
      ],
      "translated_lines": [
        "对不起，我们很急呢。",
        "快点被我们解决掉怎么样？"
      ]
    },
    "0/66_1": {
      "original_lines": [
        "ちょっと待って、って言ってるでしょ？"
      ],
      "translated_lines": [
        "我不是说了等一下么？"
      ]
    },
    "0/67_0": {
      "original_lines": [
        "お嬢様。"
      ],
      "translated_lines": [
        "大小姐。"
      ]
    },
    "0/68_0": {
      "original_lines": [
        "この程度の奴相手にしていると、きりが",
        "無いですわ。"
      ],
      "translated_lines": [
        "理睬这种程度的家伙，",
        "会没完没了的。"
      ]
    },
    "0/69_0": {
      "original_lines": [
        "そうね。"
      ],
      "translated_lines": [
        "是啊。"
      ]
    },
    "0/70_0": {
      "original_lines": [
        "まったく、ふざけてるわね！"
      ],
      "translated_lines": [
        "真是的，居然在耍我！"
      ]
    },
    "0/71_0": {
      "original_lines": [
        "夜に飛ぶ鳥を恐れた事は無いのかしら？"
      ],
      "translated_lines": [
        "没怕过在夜晚飞翔的鸟吗？"
      ]
    },
    "0/72_0": {
      "original_lines": [
        "フライドチキン、でしょ？",
        "私は人間がいいわ。"
      ],
      "translated_lines": [
        "Fried chicken吗？",
        "对我来说，人类比较好呢。"
      ]
    },
    "0/73_0": {
      "original_lines": [
        "（何が良いのかしら？）",
        "お嬢様、flyはフライドに変形しません。"
      ],
      "translated_lines": [
        "（什么比较好啊？）",
        "大小姐，fly不会变形成fried的。"
      ]
    },
    "0/74_0": {
      "original_lines": [
        "なんでもいいわ。",
        "私が本当の闇夜の恐怖を教えてあげる！"
      ],
      "translated_lines": [
        "怎么都好。",
        "我来教教你们什么是暗夜的恐怖吧！"
      ]
    },
    "0/75_0": {
      "original_lines": [
        "闇夜の恐怖、ねぇ……"
      ],
      "translated_lines": [
        "暗夜的恐怖，吗……"
      ]
    },
    "1/60_0": {
      "original_lines": [
        "さぁ、咲夜。そいつをフライにするか、",
        "それとも先に進むか、どっちが良い？"
      ],
      "translated_lines": [
        "好了，咲夜。要先炸那家伙，",
        "还是先前进呢？"
      ]
    },
    "1/61_0": {
      "original_lines": [
        "フライは後にして、先に進みましょう。",
        "夜は短いのですよ。"
      ],
      "translated_lines": [
        "之后再炸，先往前走吧。",
        "夜晚是很短的。"
      ]
    },
    "1/62_0": {
      "original_lines": [
        "そういえば、なんでこっちに向ってる",
        "んでしょうか？"
      ],
      "translated_lines": [
        "话说，为什么",
        "往这边走？"
      ]
    },
    "1/63_0": {
      "original_lines": [
        "ん？、燃料補給。"
      ],
      "translated_lines": [
        "嗯？燃料补给。"
      ]
    },
    "1/64_0": {
      "original_lines": [
        "……"
      ],
      "translated_lines": [
        "……"
      ]
    }
  }
}
